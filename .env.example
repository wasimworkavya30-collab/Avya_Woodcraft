# Copy this file to .env and change the values before deploying.
# Requires Node.js 22.5 or newer (the app uses the built-in SQLite engine).

# Port the API (and, after `npm run build`, the built frontend) listens on.
PORT=4000

# Signing key for login tokens. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# SQLite database file. Relative to the repository root.
DATABASE_FILE=data/avya.db

# Workshop location used by the attendance geofence.
WORKSHOP_LAT=17.3850
WORKSHOP_LNG=78.4867
GEOFENCE_METRES=150

# First admin account, created automatically when the database is empty.
ADMIN_EMAIL=admin@avyawoodcraft.in
ADMIN_PASSWORD=Avya@2026

# Load the sample employees / attendance on first boot (true or false).
SEED_DEMO=true
